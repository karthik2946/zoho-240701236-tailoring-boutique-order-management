		menu
		{
			space Space
			{
				displayname = "space"
				icon = "tech-desktop"

				section Home
				{
					displayname = "Home"
					icon = "ui-1-home-minimal"
					page Mens_Tailoring_Dashboard
					{
						icon = "ui-1-dashboard-half"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = connection
						displayname = "Connection"
						icon = "tech-2-device-connection"
					}
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Task"
						icon = "design-todo"
					}
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Task"
						icon = "ui-2-hourglass"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Customer_Details
				{
					displayname = "Customer Details"
					icon = "users-2-contacts-44"
					form  Customer_Details
					{
						icon = "users-2-contacts-44"
					}
					report All_Customer_Details
					{
						icon = "tech-desktop"
					}
				}
				section Customer_Measurements
				{
					displayname = "Customer Measurements"
					icon = "ui-1-database"
					form  Customer_Measurements
					{
						icon = "ui-1-database"
					}
					report All_Customer_Measurements
					{
						icon = "tech-desktop"
					}
				}
				section Orders
				{
					displayname = "Orders"
					icon = "shopping-list"
					form  Tailoring_Orders
					{
						icon = "shopping-list"
					}
					report All_Orders
					{
						icon = "tech-desktop"
					}
					report All_Tailoring_Orders
					{
						icon = "shopping-list"
					}
					report Pending_Orders
					{
						icon = "shopping-list"
					}
					report Delivered_Orders
					{
						icon = "shopping-list"
					}
					report Overdue_Deliveries
					{
						icon = "shopping-list"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
					show = {section,component}
				}
			}
		}
		customize
		{
			font = "lato"
			color options
			{
				color = "11"
			}
			logo
			{
				preference = "app_icon"
				placement = "left"
			}
		}
	}
	phone
	{
		forms
		{
			form Customer_Details
			{
				label placement = auto
			}
			form Customer_Measurements
			{
				label placement = auto
			}
			form Tailoring_Orders
			{
				label placement = auto
			}
		}
		customize
		{
			layout = onecolumn
			font = "default"
			style = "3"
			color options
			{
				color = yellow
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		forms
		{
			form Customer_Details
			{
				label placement = auto
			}
			form Customer_Measurements
			{
				label placement = auto
			}
			form Tailoring_Orders
			{
				label placement = auto
			}
		}
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = yellow
			}
			logo
			{
				preference = "none"
			}
		}
	}
